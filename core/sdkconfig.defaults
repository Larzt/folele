# Target board: ESP32 DevKit (ESP32-WROOM-32)
CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# 1 ms tick so vTaskDelay(pdMS_TO_TICKS(n)) works for small delays
CONFIG_FREERTOS_HZ=1000

# Console (Logger) on UART0
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

# Power management: dynamic frequency scaling + automatic light sleep
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
# Time spent in each power mode (shown in the log, /status and /power/stats)
CONFIG_PM_PROFILING=y
